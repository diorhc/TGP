{
  "name": "telegramplus",
  "version": "2.0",
  "description": "Telegram + — video & story downloads, hotkeys, ad-blocking, settings panel.",
  "private": true,
  "main": "telegram.user.js",
  "scripts": {
    "build": "node scripts/build.js",
    "build:optimized": "npm run build && node scripts/build-esbuild.js --optimized",
    "build:min": "npm run build && node scripts/build-esbuild.js --min",
    "check:modules": "node scripts/check-modules.js",
    "check:legacy-files": "node scripts/check-legacy-files.js",
    "check:version": "node scripts/check-version-sync.js",
    "check:version:bundle": "node scripts/check-version-sync.js --include-bundle",
    "check:locales": "node scripts/validate-locales.js",
    "check:i18n": "node scripts/check-i18n-keys.js",
    "check:security": "node scripts/check-security-patterns.js",
    "validate:build": "node scripts/validate-build.js",
    "test": "jest",
    "lint": "eslint src scripts test build.js --ext .js",
    "lint:fix": "eslint src scripts test build.js --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "changelog": "node scripts/generate-changelog.js",
    "validate": "npm run check:modules && npm run check:legacy-files && npm run check:version && npm run check:locales && npm run check:i18n && npm run check:security && npm run lint && npm run test && npm run build && npm run check:version:bundle && npm run validate:build",
    "prepare": "node scripts/prepare-husky.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.3.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "esbuild": "^0.28.0"
  },
  "keywords": [
    "telegram",
    "userscript",
    "tampermonkey",
    "violentmonkey",
    "download"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diorhc/TGP.git"
  }
}
